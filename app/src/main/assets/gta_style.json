{
  "version": 8,
  "name": "GPS Auto",
  "sources": {
    "omt": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#d6d3cb" }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "omt",
      "source-layer": "landcover",
      "filter": ["in", ["get", "class"], ["literal", ["grass", "wood", "farmland", "wetland"]]],
      "paint": { "fill-color": "#ccd1c1", "fill-opacity": 0.7 }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "omt",
      "source-layer": "park",
      "paint": { "fill-color": "#c4cbb9" }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "omt",
      "source-layer": "landuse",
      "filter": ["in", ["get", "class"], ["literal", ["cemetery", "stadium", "pitch", "playground"]]],
      "paint": { "fill-color": "#c9cdbf" }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "omt",
      "source-layer": "water",
      "paint": { "fill-color": "#a7b8c0" }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "omt",
      "source-layer": "waterway",
      "paint": { "line-color": "#a7b8c0", "line-width": 1.5 }
    },
    {
      "id": "aeroway",
      "type": "fill",
      "source": "omt",
      "source-layer": "aeroway",
      "filter": ["==", ["geometry-type"], "Polygon"],
      "paint": { "fill-color": "#cfccc4" }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "omt",
      "source-layer": "transportation",
      "filter": ["in", ["get", "class"], ["literal", ["minor", "service", "track"]]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#eeece6",
        "line-width": ["interpolate", ["exponential", 1.6], ["zoom"], 12, 0.5, 15, 4, 18, 18, 20, 44]
      }
    },
    {
      "id": "road-casing",
      "type": "line",
      "source": "omt",
      "source-layer": "transportation",
      "filter": ["in", ["get", "class"], ["literal", ["tertiary", "secondary", "primary", "trunk", "motorway"]]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#c9c5bc",
        "line-width": ["interpolate", ["exponential", 1.6], ["zoom"], 8, 1, 12, 3, 15, 10, 18, 34, 20, 80]
      }
    },
    {
      "id": "road-major",
      "type": "line",
      "source": "omt",
      "source-layer": "transportation",
      "filter": ["in", ["get", "class"], ["literal", ["tertiary", "secondary", "primary", "trunk", "motorway"]]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#f4f2ed",
        "line-width": ["interpolate", ["exponential", 1.6], ["zoom"], 8, 0.6, 12, 2.2, 15, 8, 18, 30, 20, 72]
      }
    },
    {
      "id": "rail",
      "type": "line",
      "source": "omt",
      "source-layer": "transportation",
      "filter": ["==", ["get", "class"], "rail"],
      "paint": { "line-color": "#bdb8ae", "line-width": 1.2, "line-dasharray": [3, 3] }
    },
    {
      "id": "building-3d",
      "type": "fill-extrusion",
      "source": "omt",
      "source-layer": "building",
      "minzoom": 14,
      "paint": {
        "fill-extrusion-color": "#e3e0d9",
        "fill-extrusion-height": ["coalesce", ["get", "render_height"], 8],
        "fill-extrusion-base": ["coalesce", ["get", "render_min_height"], 0],
        "fill-extrusion-opacity": 0.92,
        "fill-extrusion-vertical-gradient": true
      }
    },
    {
      "id": "road-label",
      "type": "symbol",
      "source": "omt",
      "source-layer": "transportation_name",
      "minzoom": 14,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 12
      },
      "paint": {
        "text-color": "#7a766e",
        "text-halo-color": "#f4f2ed",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "place-label",
      "type": "symbol",
      "source": "omt",
      "source-layer": "place",
      "filter": ["in", ["get", "class"], ["literal", ["city", "town", "village", "suburb", "neighbourhood"]]],
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["match", ["get", "class"], "city", 18, "town", 15, 12],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.08
      },
      "paint": {
        "text-color": "#8a867d",
        "text-halo-color": "#d6d3cb",
        "text-halo-width": 1.6
      }
    }
  ]
}
